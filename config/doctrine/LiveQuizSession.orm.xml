<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:gedmo="http://gediminasm.org/schemas/orm/doctrine-extensions-mapping">
    <entity name="App\Domain\Entity\LiveQuizSession"
            repository-class="App\DataAccessLayer\Repository\LiveQuizSessionRepository"
            table="live_quiz_session">
        <id name="id" type="uuid" column="id">
            <generator strategy="CUSTOM"/>
            <custom-id-generator class="doctrine.uuid_generator"/>
        </id>

        <field name="name" length="200"/>
        <field name="password"/>
        <field name="isActive" type="boolean">
            <options>
                <option name="default">1</option>
            </options>
        </field>

        <many-to-one field="createdBy" target-entity="App\Domain\Entity\Attendee">
            <join-column name="created_by_id" on-delete="CASCADE" nullable="true"/>
        </many-to-one>

        <one-to-many field="questions"
                     target-entity="App\Domain\Entity\LiveQuizQuestion"
                     mapped-by="session">
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
        </one-to-many>

        <one-to-many field="participants"
                     target-entity="App\Domain\Entity\LiveQuizParticipant"
                     mapped-by="session">
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
        </one-to-many>

        <field name="createdAt" type="datetime">
            <gedmo:timestampable on="create"/>
        </field>
        <field name="updatedAt" type="datetime">
            <gedmo:timestampable on="update"/>
        </field>
    </entity>
</doctrine-mapping>
